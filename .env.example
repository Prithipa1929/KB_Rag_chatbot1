COMPANY_NAME=Acme Corp
SECRET_KEY=put-a-long-random-string-here
# Anyone registering as Admin must type this code. Empty = admin sign-up disabled.
ADMIN_SIGNUP_CODE=choose-a-private-admin-code
TOKEN_HOURS=8
COOKIE_SECURE=0

# OPTIONAL: add a Gemini key for natural-language answers. Works without it.
# GOOGLE_API_KEY=your-gemini-api-key
# LLM_MODEL=gemini-2.5-flash

# MySQL database (created automatically if the user has permission)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=kb_chatbot
